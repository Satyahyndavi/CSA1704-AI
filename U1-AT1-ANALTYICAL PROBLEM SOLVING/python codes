# Question 5 – Uniform Cost Search

```python
import heapq

graph = {
    'A': [('B', 2), ('C', 4)],
    'B': [('D', 3)],
    'C': [('D', 1)],
    'D': []
}

priority_queue = [(0, 'A')]
visited = set()

while priority_queue:
    cost, node = heapq.heappop(priority_queue)

    if node in visited:
        continue

    visited.add(node)
    print(node, "Cost =", cost)

    if node == 'D':
        print("Shortest Path Cost =", cost)
        break

    for next_node, weight in graph[node]:
        heapq.heappush(priority_queue, (cost + weight, next_node))
```


